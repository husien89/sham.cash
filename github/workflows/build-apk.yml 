name: Build Sham.Cash APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: استخراج الكود
        uses: actions/checkout@v4

      - name: إعداد Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: إنشاء Gradle Wrapper تلقائياً
        run: |
          # إنشاء مجلد
          mkdir -p gradle/wrapper
          
          # كتابة ملف الخصائص
          cat > gradle/wrapper/gradle-wrapper.properties << EOF
distributionBase=GRADLE_USER_HOME
distributionPath=wrapper/dists
distributionUrl=https\://services.gradle.org/distributions/gradle-8.5-bin.zip
networkTimeout=10000
validateDistributionUrl=true
zipStoreBase=GRADLE_USER_HOME
zipStorePath=wrapper/dists
EOF
          
          # تحميل ملف jar المطلوب
          curl -L -o gradle/wrapper/gradle-wrapper.jar https://raw.githubusercontent.com/gradle/gradle/v8.5.0/gradle-wrapper.jar
          
          # تحميل سكربتات التشغيل
          curl -L -o gradlew https://raw.githubusercontent.com/gradle/gradle/v8.5.0/gradlew
          curl -L -o gradlew.bat https://raw.githubusercontent.com/gradle/gradle/v8.5.0/gradlew.bat
          
          # منح الصلاحيات
          chmod +x gradlew

      - name: بناء ملف APK
        run: ./gradlew assembleDebug --stacktrace

      - name: التحقق من ملف APK
        run: ls -la app/build/outputs/apk/debug/

      - name: رفع ملف APK
        uses: actions/upload-artifact@v4
        with:
          name: sham.cash-apk
          path: app/build/outputs/apk/debug/app-debug.apk
