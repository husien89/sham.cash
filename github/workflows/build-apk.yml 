name: Build Android APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest
    
    steps:
      - name: استخراج الكود
        uses: actions/checkout@v4

      - name: إعداد جافا 17
        uses: actions/setup-java@v5
        with:
          java-version: '17'
          distribution: 'temurin'

      # ✅ هذا الإجراء يقوم بإنشاء ملفات wrapper تلقائياً إذا كانت مفقودة
      - name: إعداد Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.5'
          generate-wrapper: true  # 🔑 ينشئ الملفات المفقودة تلقائياً

      - name: منح صلاحيات التنفيذ
        run: chmod +x gradlew

      - name: بناء APK
        run: ./gradlew assembleDebug --stacktrace

      - name: رفع APK
        uses: actions/upload-artifact@v4
        with:
          name: ShamCash-APK
          path: app/build/outputs/apk/debug/*.apk

